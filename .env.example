PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ytci
# Comma-separated list of allowed CORS origins for the backend. Also used by
# Cloudflare R2 CORS policy for browser-based presigned URL uploads.
CORS_ALLOWED_ORIGINS=*
ADMIN_JWKS_URL=https://admin.yourdomain.com/api/auth/jwks
JWT_EXPECTED_ISSUER=
JWT_EXPECTED_AUDIENCE=ytci-api
# Cloudflare R2 — bucket-level CORS must also be configured manually in the
# Cloudflare dashboard (R2 -> Bucket -> Settings -> CORS Policy) to allow
# PUT requests from your admin dashboard origin. Without this, browser-based
# media uploads via presigned URLs will fail with CORS errors.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ytci-media
EXPO_PUSH_TOKEN=
LOG_LEVEL=info
JWKS_CACHE_TTL_MINUTES=60
