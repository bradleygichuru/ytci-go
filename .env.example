# Deployment tier: development | staging | production. Outside development the
# server refuses to start when a required secret is unset (see MICE_TICKET_SECRET).
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ytci
# Comma-separated list of allowed CORS origins for the backend. Also used by
# Cloudflare R2 CORS policy for browser-based presigned URL uploads.
CORS_ALLOWED_ORIGINS=*
ADMIN_JWKS_URL=https://admin.yourdomain.com/api/auth/jwks
JWT_EXPECTED_ISSUER=
JWT_EXPECTED_AUDIENCE=ytci-api
# Cloudflare R2 — bucket-level CORS must also be configured manually in the
# Cloudflare dashboard (R2 -> Bucket -> Settings -> CORS Policy) to allow
# PUT requests from your admin dashboard origin. Without this, browser-based
# media uploads via presigned URLs will fail with CORS errors.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ytci-media
# Required by config.Load: the server refuses to start without it.
GOOGLE_PLACES_API_KEY=
EXPO_PUSH_TOKEN=
LOG_LEVEL=info
JWKS_CACHE_TTL_MINUTES=60

# HMAC key for signed MICE event tickets. Required when APP_ENV is not
# development: the server exits at startup rather than sign tickets with the
# built-in development key. Rotating it invalidates tickets already issued.
# Generate one with: openssl rand -base64 32
MICE_TICKET_SECRET=
MICE_NOTIFICATIONS_ENABLED=false

# Then & Now. Recognition and analytics v2 stay dark until the privacy
# enablement gate is signed.
THEN_NOW_RECOGNITION_ENABLED=false
THEN_NOW_PUBLIC_RECOGNITION_ENABLED=false
THEN_NOW_ANALYTICS_V2_ENABLED=false
THEN_NOW_MEDIA_URL_TTL_MINUTES=15

# Analytics consent version and the #346 under-18 gate. The gate stays off
# unless explicitly enabled.
ANALYTICS_CONSENT_VERSION=2026-11-01
ANALYTICS_UNDER_18_IDENTIFIED_ENABLED=false

# Google Cloud Vision receipt OCR (optional; manual entry remains available)
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://eu-vision.googleapis.com
